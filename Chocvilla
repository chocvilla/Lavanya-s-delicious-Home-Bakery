<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chocvilla</title>

<style>
body{
  font-family:sans-serif;
  background:#fdf8f2;
  margin:0;
  text-align:center;
}

h1{margin-top:20px;}

.btn{
  padding:10px 20px;
  background:#3b1f0e;
  color:white;
  border:none;
  border-radius:6px;
  cursor:pointer;
  margin:5px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:15px;
  padding:20px;
}

.card{
  background:white;
  padding:15px;
  border-radius:10px;
  box-shadow:0 2px 8px rgba(0,0,0,0.1);
}

.item-img{font-size:50px;}

#modal{
  display:none;
  position:fixed;
  top:0;left:0;
  width:100%;height:100%;
  background:#0008;
  justify-content:center;
  align-items:center;
}

.modal-box{
  background:white;
  padding:20px;
  border-radius:10px;
  width:250px;
}
</style>
</head>

<body>

<h1>🍫 Chocvilla</h1>

<button class="btn" onclick="goWhatsApp()">Order Now</button>
<button class="btn" onclick="openModal()">+ Add Product</button>

<div class="grid" id="grid"></div>

<!-- MODAL -->
<div id="modal">
  <div class="modal-box">
    <h3>Add Product</h3>

    <select id="emoji">
      <option>🍫</option>
      <option>🎂</option>
      <option>🧁</option>
      <option>🍪</option>
    </select><br><br>

    <input id="name" placeholder="Name"><br><br>
    <input id="price" placeholder="Price"><br><br>

    <button onclick="save()">Save</button>
    <button onclick="closeModal()">Cancel</button>
  </div>
</div>

<script type="module">

// 🔥 Firebase CDN (CORRECT FOR HTML)
import { initializeApp } 
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import { getFirestore, collection, addDoc, getDocs, deleteDoc, doc } 
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

// 🔥 YOUR FIREBASE CONFIG (FIXED)
const firebaseConfig = {
  apiKey: "AIzaSyDdJjVQKJUcGWISq_bpXK-aznsCl49VGOY",
  authDomain: "chocvilla-344b6.firebaseapp.com",
  projectId: "chocvilla-344b6",
  storageBucket: "chocvilla-344b6.appspot.com",
  messagingSenderId: "694977493407",
  appId: "1:694977493407:web:85275bf76af7695e0e65aa"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

let products = [];

// LOAD PRODUCTS
async function load(){
  const snap = await getDocs(collection(db,"products"));
  products = [];

  snap.forEach(d=>{
    products.push({id:d.id,...d.data()});
  });

  render();
}

// RENDER UI
function render(){
  document.getElementById("grid").innerHTML = products.map(p=>`
    <div class="card">
      <div class="item-img">${p.emoji}</div>
      <h3>${p.name}</h3>
      <p>₹${p.price}</p>

      <button onclick="order('${p.name}')">Order</button>
      <button onclick="del('${p.id}')">Delete</button>
    </div>
  `).join("");
}

// SAVE PRODUCT
window.save = async ()=>{
  let name = document.getElementById("name").value;
  let price = document.getElementById("price").value;
  let emoji = document.getElementById("emoji").value;

  if(!name || !price){
    alert("Fill all fields");
    return;
  }

  try{
    await addDoc(collection(db,"products"),{
      name, price, emoji
    });

    closeModal();
    load();
  }catch(e){
    alert(e.message);
  }
};

// DELETE PRODUCT
window.del = async (id)=>{
  await deleteDoc(doc(db,"products",id));
  load();
};

// WHATSAPP ORDER
window.order = (name)=>{
  let msg = encodeURIComponent("Hi, I want to order " + name + " from Chocvilla");
  window.open("https://wa.me/919490021604?text=" + msg);
};

window.goWhatsApp = ()=>{
  window.open("https://wa.me/919490021604");
};

// MODAL
window.openModal = ()=> modal.style.display="flex";
window.closeModal = ()=> modal.style.display="none";

load();

</script>

</body>
</html>
